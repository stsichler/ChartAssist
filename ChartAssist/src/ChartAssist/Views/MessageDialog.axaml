<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ChartAssist.Views.MessageDialog"
        Icon="/Assets/Icon.ico"
        SizeToContent="WidthAndHeight"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        MinWidth="360" MaxWidth="520">

  <StackPanel Margin="20" Spacing="20">
    <TextBlock x:Name="MessageText" TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="Ja" MinWidth="80" IsDefault="True" Click="OnYes" />
      <Button Content="Nein" MinWidth="80" IsCancel="True" Click="OnNo" />
    </StackPanel>
  </StackPanel>

</Window>
