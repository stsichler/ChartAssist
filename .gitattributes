# Entwicklung unter Linux: LF für alle Textdateien
* text=auto eol=lf

# Binärdateien
*.png binary
*.jpg binary
*.ico binary
*.icns binary
*.pdf binary

# XML-Fixtures der Datenbank-Tests unverändert lassen: .ChartButler.xml wird
# immer mit CRLF geschrieben und byteweise verglichen
ChartAssist/tests/**/Fixtures/*.xml -text

# Windows-Skripte brauchen CRLF
*.cmd text eol=crlf
